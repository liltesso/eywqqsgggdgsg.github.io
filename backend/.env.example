# ╔══════════════════════════════════════════════════════════════╗
# ║  Merchant Partners — NFT Rental & Sale backend configuration   ║
# ║  Copy to `.env` and fill in real values.                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── MarketApp (MRKT) API ────────────────────────────────────────
# Get your token at https://marketapp.ws/api-token
MARKETAPP_API_TOKEN=your_marketapp_api_token_here
MARKETAPP_BASE_URL=https://api.marketapp.ws

# ─── Telegram bot ────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public https URL of THIS backend (for webhook registration)
PUBLIC_BASE_URL=https://your-backend.example.com
# Secret string used to validate Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_long_random_string

# ─── Your markup / commission ────────────────────────────────────
# Percent added on top of MarketApp's price (e.g. 15 = +15%)
MARKUP_PERCENT=15
# TON wallet (raw or user-friendly) that receives your commission
MERCHANT_WALLET=UQYour_Merchant_TON_Wallet_Address

# ─── Display: TON -> Telegram Stars conversion (display only) ─────
# Used to show an approximate Stars price in the UI.
STARS_PER_TON=77

# ─── Catalog cache (anti rate-limit, see spec §4) ────────────────
# Seconds to cache the MRKT catalog before refreshing.
CATALOG_CACHE_TTL=8

# ─── TON blockchain / on-chain verification (TonAPI) ─────────────
# Optional API key from https://tonconsole.com (higher rate limits).
# Without it the public tier still works for low volume.
TONAPI_KEY=
TONAPI_BASE_URL=https://tonapi.io
# Set true to operate on TON testnet (TONAPI_BASE_URL must match).
TESTNET=false
# USDT jetton master (mainnet) — used for jetton-priced sales.
USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# ─── Order confirmation worker ───────────────────────────────────
# Background sweep that verifies TonConnect payments settled on-chain
# before marking an order fulfilled.
ENABLE_CONFIRMATION_WORKER=true
CONFIRM_POLL_INTERVAL=6      # seconds between sweeps
CONFIRM_TIMEOUT=600         # seconds before an unconfirmed order expires

# ─── Database ────────────────────────────────────────────────────
# SQLite by default; swap to postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./rental.db

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API (your Mini App URL)
CORS_ORIGINS=https://eywqqsgggdgsg.github.io,http://localhost:8080

# ─── OPTIONAL: Stars/treasury path (advanced, needs custody) ─────
# Only set these if you run the system-wallet signing flow.
# WARNING: this requires your own TON funds and gift custody.
# WALLET_MNEMONIC=word1 word2 ... word24
# TONAPI_KEY=
